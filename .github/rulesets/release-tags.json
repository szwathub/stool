{
  "name": "git-flow release tags",
  "target": "tag",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": [
        "refs/tags/v*"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "update"
    },
    {
      "type": "deletion"
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "required_status_checks": [
          {
            "context": "master-release",
            "integration_id": 15368
          }
        ],
        "strict_required_status_checks_policy": false,
        "do_not_enforce_on_create": false
      }
    }
  ]
}
