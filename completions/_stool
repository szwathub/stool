(( $+functions[_stool_commands] )) ||
_stool_commands() {
    local commands; commands=(
'init:Save dotfiles defaults, initialize Apple settings and optionally restore offline keys' \
'dotfile:Manage dotfiles from a Git repository' \
'secrets:Back up and restore GPG and SSH keys independently of dotfiles' \
'completions:Generate shell completions from the current command definitions' \
'man:Render the manual, or write all command manuals to a directory' \
'apple:Manage macOS preferences and Homebrew independently of dotfiles' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'stool commands' commands "$@"
}
